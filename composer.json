{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nativephp/kitchen-sink-vue",
    "type": "project",
    "description": "The NativePHP Mobile Kitchen Sink Vue App",
    "keywords": [
        "nativephp",
        "laravel",
        "ios",
        "android"
    ],
    "authors": [
        {
            "name": "Simon Hamp",
            "email": "simon@nativephp.com",
            "role": "Co-founder"
        },
        {
            "name": "Shane Rosenthal",
            "email": "shane@nativephp.com",
            "role": "Co-founder"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://plugins.nativephp.com"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/fortify": "^1.30",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "laravel/wayfinder": "^0.1.9",
        "nativephp/mobile": "dev-move-php-version-to-config",
        "nativephp/mobile-biometrics": "^1.0",
        "nativephp/mobile-browser": "^1.0",
        "nativephp/mobile-camera": "^1.0",
        "nativephp/mobile-device": "^1.0",
        "nativephp/mobile-dialog": "^1.0",
        "nativephp/mobile-file": "^1.0",
        "nativephp/mobile-firebase": "^1.0",
        "nativephp/mobile-geolocation": "^1.0",
        "nativephp/mobile-microphone": "^1.0",
        "nativephp/mobile-network": "^1.0",
        "nativephp/mobile-scanner": "^1.0",
        "nativephp/mobile-secure-storage": "^1.0",
        "nativephp/mobile-share": "^1.0",
        "nativephp/mobile-system": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "fortephp/forte": "^0.1.0",
        "laravel/boost": "^1.8",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.0",
        "textalk/websocket": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
